# ==================================
# 生产环境配置模板（内网 / 无域名 / 无证书）
#
# 使用方式（在服务器上执行）：
#   cp backend/env/.env.prod.example backend/env/.env.prod
#   然后修改下面标注 <<必须修改>> 的项
#
# 注意：
# 1. 本文件会被 Dockerfile COPY 进后端镜像，属于构建产物的一部分，
#    因此必须【先配置好再执行 docker compose build】。
# 2. .env.prod 已被 .gitignore 排除，请勿提交到仓库。
# 3. docker compose 会通过容器环境变量传入 DATABASE_* / REDIS_*，
#    其优先级高于本文件。也就是说：改数据库密码要改 docker/.env，
#    改这里不会生效（非 compose 方式直接运行时才会用到）。
# ==================================

ENVIRONMENT = prod

# ==================== 服务器配置 ====================
SERVER_HOST = 0.0.0.0
SERVER_PORT = 8001
# uvicorn worker 进程数（>1 时确保 Redis 共享 jobstore 不重复调度）
WORKERS = 1
# 前置可信反向代理跳数：docker 部署为单层 nginx，保持 1
TRUSTED_PROXY_HOPS = 1

# ==================== 文档 / 调试 ====================
# 生产环境必须为 False，否则 uvicorn 会开启 reload
DEBUG = False
VERSION = 3.1.0
DEMO_ENABLE = False

# ==================== 安全中间件 ====================
# 是否强制 HTTP → HTTPS 重定向。
# 本方案 nginx 以 HTTPS 对外提供服务，并以 X-Forwarded-Proto: https 转发到后端，
# 因此保持 True 不会触发任何跳转（只在请求确实不是 https 时才跳）。
# 仅当改为「纯 HTTP 部署」时才需要设为 False，否则所有请求会被 301 到
# 一个并不存在的 https 端口，表现为页面直接打不开。
HTTPS_REDIRECT_ENABLE = True

# <<必须修改>> 用 IP 访问时必须放开 Host 头校验，否则返回 400 Invalid host header。
# 该字段是 list 类型，必须写成 JSON 数组格式，不能写 "*"。
ALLOWED_HOSTS = ["*"]

# 生产环境允许的跨域来源，逗号分隔。前后端由同一个 nginx 提供（同源），
# 留空即可；留空时 ALLOW_ORIGINS 回退为 ["*"]。
PROD_CORS_ORIGINS =

# ==================== 密钥 ====================
# <<必须修改>> JWT 签名密钥。生成方式：openssl rand -hex 32
# 不修改会使用代码里的开发默认值，等同于没有认证安全。
SECRET_KEY = CHANGE_ME_openssl_rand_hex_32

# 敏感数据加密主密钥（可选）。生成方式：openssl rand -hex 32
# 留空时由 SECRET_KEY 经 HKDF 派生。注意：一旦设置后不可随意变更，
# 否则已加密的历史数据将无法解密。
# DATA_ENCRYPTION_KEY =

# ==================== 数据库配置 ====================
# 以下连接参数在 docker compose 部署下由 MYSQL_* 环境变量覆盖
DATABASE_TYPE = mysql
DATABASE_HOST = mysql
DATABASE_PORT = 3306
DATABASE_USER = fastapiadmin
DATABASE_PASSWORD = CHANGE_ME
DATABASE_NAME = fastapiadmin

# ==================== Redis 配置 ====================
# 以下连接参数在 docker compose 部署下由 REDIS_* 环境变量覆盖
REDIS_HOST = redis
REDIS_PORT = 6379
REDIS_USER = ''
REDIS_PASSWORD = CHANGE_ME
REDIS_DB_NAME = 1

# ==================== 日志级别 ====================
# DEBUG / INFO / WARNING / ERROR
LOGGER_LEVEL = INFO

# ==================== 大模型配置 ====================
# 内网环境若无法访问外网，请改为内网可达的兼容 OpenAI 协议的地址
OPENAI_BASE_URL = https://api.deepseek.com
OPENAI_API_KEY = CHANGE_ME
OPENAI_MODEL = deepseek-v4-flash

# ==================== 第三方 OAuth 登录（可选） ====================
# 回退的前端登录页地址，仅在 OAuth 回调无法从 state 还原前端地址时使用。
# 默认留空（不回退到任何写死的地址）；启用第三方登录时填部署后的实际地址。
# 各渠道凭证（OAUTH_<渠道>_CLIENT_ID / _SECRET）未配置时，前端不呈现对应登录入口。
# OAUTH_FRONTEND_FALLBACK = https://your-domain/login
