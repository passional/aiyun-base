# 【生产】环境变量 - 覆盖通用配置（案例）
#
# 使用方式（本地构建前）：
#   cp frontend/web/.env.production.example frontend/web/.env.production
#   然后把 VITE_APP_WS_ENDPOINT 改成服务器实际的内网地址
#
# 构建命令：cd frontend/web && pnpm build
# （pnpm build 走 vite 默认的 production 模式，读取本文件）

# 环境标识
VITE_APP_ENV = prod

# 项目名称
VITE_APP_TITLE = FastapiAdmin

# 浏览器侧 API 前缀。前后端由同一个 nginx 提供（同源），用相对路径即可。
# 该值用于拼接文件上传地址（如 /file/upload），未配置时会拼出 "undefined/file/upload"。
VITE_API_URL = /

# 是否删除控制台输出（实际由 vite.config.ts 的 terser drop_console 控制）
VITE_DROP_CONSOLE = true

# WebSocket 端点：AI 对话 / 传输进度 / 渠道评估进度依赖它。
# 内网无域名时填「IP:端口」，且协议必须与部署方式一致。
# 【关键】这里的端口要填【浏览器地址栏里显示的那个端口】，也就是物理宿主的
# NAT 对外端口（如 8443），不是 nginx 在服务器上监听的 443 —— 这个值会被
# 编译进 JS，浏览器直接拿它去连，填服务器内部端口必然握手失败。
#   HTTPS 部署（对外 8443）→ wss://192.168.10.15:8443
#   纯 HTTP 部署           → ws://<IP>:<端口>
# 写错协议会握手失败，表现为对话和进度条一直不更新。
VITE_APP_WS_ENDPOINT = wss://192.168.10.15:8443

# 说明：VITE_API_BASE_URL 只被 vite dev server 的代理使用，
# 生产构建不读取，无需配置。
