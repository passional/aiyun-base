# Docker 部署环境变量（案例）

# 数据库配置
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=fastapiadmin
MYSQL_USER=fastapiadmin
MYSQL_PASSWORD=your_mysql_password
MYSQL_PORT=3306

# Redis配置
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# 后端配置
BACKEND_PORT=8001
BACKEND_IMAGE_TAG=3.0.0
# 构建后端镜像时的 pip 安装源（默认阿里云，留空即用默认值）。
# 某些内网会拦截特定镜像站的下载（表现为 HTTP 403），换一家即可：
#   阿里云  https://mirrors.aliyun.com/pypi/simple/
#   腾讯云  https://mirrors.cloud.tencent.com/pypi/simple/
#   清华    https://pypi.tuna.tsinghua.edu.cn/simple
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOGGER_LEVEL=INFO

# Nginx配置：宿主机 HTTPS 端口（容器内固定监听 443）
# 访问地址即 https://<服务器IP>:<HTTPS_PORT>
HTTPS_PORT=8443
# nginx 监听的宿主机地址。留空或 0.0.0.0 = 所有网卡；
# 填服务器内网 IP 可把访问限制到该地址（推荐，见 DEPLOYMENT.md 第 2 节）
# BIND_IP=192.168.10.15

# 项目配置
PROJECT_NAME=FastapiAdmin

# 部署环境
DEPLOY_ENV=prod
